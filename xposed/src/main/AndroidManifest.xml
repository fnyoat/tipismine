<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 目标页面需要读取 SystemUI 的版本 / APK 哈希信息（Android 11+ 包可见性）。 -->
    <queries>
        <package android:name="com.android.systemui" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".ui.ConfigActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/menu_settings" />

        <activity
            android:name=".ui.LockScreenConfigActivity"
            android:exported="false"
            android:label="@string/lock_settings_title" />

        <activity
            android:name=".ui.DebugActivity"
            android:exported="false"
            android:label="@string/menu_target_resources" />
    </application>
</manifest>